# Application
APP_NAME=HR Decision Support Platform
APP_ENV=local

# Runtime paths
OUTPUT_DIR=output
DOCUMENT_DIR=data/documents
CONVERSATION_DB_PATH=data/runtime/conversations.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs
ENABLE_FILE_LOGGING=false

# Conversation audit
CHAT_AUDIT_ENABLED=true
ADMIN_USERS=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=workforce-knowledge-index
AZURE_SEARCH_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=


# Local development identity
LOCAL_USER_ID=local.user
LOCAL_USER_NAME=Local User
